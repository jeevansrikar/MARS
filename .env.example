# Copy to .env. Supply your own credentials; never commit .env.
ENVIRONMENT=development
POSTGRES_USER=mars
POSTGRES_DB=mars
POSTGRES_PASSWORD=replace-with-a-random-local-password
# Local Python processes use host ports; Compose overrides these hostnames.
DATABASE_URL=postgresql+asyncpg://mars:replace-with-a-random-local-password@127.0.0.1:5432/mars
REDIS_URL=redis://127.0.0.1:6379/0
ALLOWED_ORIGINS=["http://localhost:3000"]
ANTHROPIC_API_KEY=
# Tavily API key. Real search is required; no demonstration fallback.
SEARCH_API_KEY=
RESEARCH_MODEL=claude-sonnet-4-6
FAST_MODEL=claude-haiku-4-5
SYNTHESIS_MODEL=claude-sonnet-4-6
VERIFICATION_MODEL=claude-sonnet-4-6
METRICS_TOKEN=
PROVIDER_TIMEOUT=90
PROVIDER_RETRIES=2
MAX_OUTPUT_TOKENS=2048
MAX_INPUT_BYTES=96000
MAX_AGENT_CALLS=32
MAX_SEARCH_CALLS=4
MAX_SOURCES=8
MAX_SOURCE_BYTES=1000000
MAX_DOCUMENT_CHARS=24000
MAX_JOB_SECONDS=900
MAX_ATTEMPTS=3
LEASE_SECONDS=45
WORKER_CONCURRENCY=2
MAX_ACTIVE_JOBS=2
DAILY_JOB_QUOTA=20
MAX_DEBATE_ROUNDS=2
API_RATE_PER_MINUTE=120
SESSION_DAYS=7
MEMORY_TTL_DAYS=90
# Optional OTLP HTTP collector (including /v1/traces where required by exporter).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional model pricing, USD per million tokens; leave unknown rather than inventing prices.
MODEL_PRICES={}

# Local CPU embeddings: provision pinned assets with python -m app.providers.embeddings --download
SEMANTIC_ENABLED=true
EMBEDDING_CACHE_DIR=.model-cache
EMBEDDING_REVISION=d13954661f83248295ba75c1ed411eef3b7b936e
